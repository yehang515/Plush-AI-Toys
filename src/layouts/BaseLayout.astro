---
import '../styles/global.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const assetBase = import.meta.env.BASE_URL;
const favicon = assetBase === '/' ? '/favicon.svg' : `${assetBase}/favicon.svg`;
const logo = new URL(assetBase === '/' ? '/images/logo.jpg' : `${assetBase}/images/logo.jpg`, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Pluzy AI Toy Factory" />
    <meta property="og:image" content={logo} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} | Pluzy</title>
  </head>
  <body><slot /></body>
</html>
