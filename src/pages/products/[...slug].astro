---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingContact from '../../components/FloatingContact.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.filter((product) => product.data.images?.length).map((product) => ({ params: { slug: product.id }, props: { product } }));
}
interface Props { product: CollectionEntry<'products'>; }
const { product } = Astro.props;
const { data } = product;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => base === '/' ? path : `${base}${path}`;
const videoId = data.video?.match(/(?:shorts\/|youtu\.be\/|v=)([^?&/]+)/)?.[1];
const specs = [
  ['Recommended age', 'Suitable for ages 3+'], ['Height', '26 cm'], ['Craft', 'Embroidery'], ['Fabric', 'Tie-dyed and brushed rabbit fur'], ['Filling', 'PP cotton'], ['MOQ for wholesale', '50 pcs'], ['Packaging', 'Each toy with PDQ'], ['Carton pack', '8 pcs / CTN'], ['Carton size', '45 × 45 × 53 cm'],
];
const features = ['Built-in AI device', 'LED screen eyes', 'Voice cloning', 'Switchable languages', 'Huggable'];
---
<BaseLayout title={`${data.title} | AI Plush Toy Wholesale`} description={data.excerpt}>
  <Header />
  <FloatingContact />
  <main class="pt-28"><section class="container-site py-10 sm:py-16"><a href={base} class="text-sm font-bold text-ink/60 hover:text-coral">← Back to home</a><div class="mt-7 grid gap-10 lg:grid-cols-[1.05fr_.95fr]"><div><img src={withBase(data.image!)} alt={data.title} class="aspect-square w-full rounded-3xl object-cover shadow-xl" /><div class="mt-4 grid grid-cols-3 gap-3">{data.images?.slice(1, 4).map((image) => <img src={withBase(image)} alt={`${data.title} detail`} class="aspect-square w-full rounded-2xl object-cover" />)}</div></div><div class="lg:pt-4"><p class="eyebrow">{data.category}</p><h1 class="font-display text-5xl font-bold tracking-tight sm:text-6xl">{data.title}</h1><p class="mt-5 max-w-xl text-lg leading-8 text-ink/70">{data.excerpt}</p><div class="mt-8 flex flex-wrap gap-2">{features.map((feature) => <span class="rounded-full bg-mist px-4 py-2 text-sm font-bold text-moss">{feature}</span>)}</div><p class="mt-8 text-sm leading-6 text-ink/65">The more quantity you order, the better the price. Contact us to request wholesale pricing and a tailored quote.</p><div class="mt-8 flex flex-wrap gap-3"><a class="button-primary" href="https://wa.me/8617625983675">Get wholesale quote →</a><a class="button-secondary" href="mailto:kyel.zhanghang@gmail.com?subject=AI%20Companion%20Plush%20Inquiry">Email inquiry</a></div></div></div></section>
  {videoId && <section class="bg-ink py-20 text-white"><div class="container-site grid items-center gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow">See it in action</p><h2 class="font-display text-4xl font-bold">AI interaction in a soft, huggable form.</h2><p class="mt-5 leading-7 text-white/65">Watch the product video, then contact us to discuss product features, branding and wholesale requirements.</p><a class="button-primary mt-7 !bg-coral" href={data.video}>Open on YouTube →</a></div><div class="overflow-hidden rounded-3xl bg-white/10 shadow-xl"><iframe class="aspect-[9/16] w-full max-h-[620px]" src={`https://www.youtube.com/embed/${videoId}`} title={`${data.title} video`} loading="lazy" allowfullscreen></iframe></div></div></section>}
  <section class="py-20 sm:py-28"><div class="container-site"><p class="eyebrow">Product specification</p><h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Product details at a glance.</h2><div class="mt-10 grid overflow-hidden rounded-3xl border border-ink/10 sm:grid-cols-2">{specs.map(([label, value]) => <div class="flex justify-between gap-5 border-b border-ink/10 p-5 sm:p-6"><span class="text-sm font-bold text-ink/60">{label}</span><span class="text-right text-sm font-bold">{value}</span></div>)}</div></div></section>
  <section class="bg-mist py-20 sm:py-28"><div class="container-site"><p class="eyebrow">Product gallery</p><h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Every detail, considered.</h2><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{data.images?.map((image, index) => <img src={withBase(image)} alt={`${data.title} product view ${index + 1}`} loading="lazy" class="aspect-square w-full rounded-2xl object-cover" />)}</div></div></section>
  <section class="bg-coral py-16"><div class="container-site flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center"><div><h2 class="font-display text-3xl font-bold">Ready to discuss your order?</h2><p class="mt-2 text-ink/70">Ask about wholesale prices, branding and custom options.</p></div><a class="button-primary" href="https://wa.me/8617625983675">Chat on WhatsApp →</a></div></section></main>
  <Footer />
</BaseLayout>
