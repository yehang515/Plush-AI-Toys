---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({ params: { slug: topic.id }, props: { topic } }));
}
interface Props { topic: CollectionEntry<'topics'>; }
const { topic } = Astro.props;
const { Content } = await render(topic);
const topics = (await getCollection('topics')).filter((item) => item.id !== topic.id).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const base = import.meta.env.BASE_URL;
const basePath = base === '/' ? '/' : `${base}/`;
const faq = [
  { question: 'Can I request a custom AI plush toy?', answer: 'Yes. Share your character, intended interaction, target market and expected quantity to begin a focused product conversation.' },
  { question: 'Do you support OEM and ODM projects?', answer: 'Yes. OEM is suitable for established specifications, while ODM can help shape a product direction from an earlier brief.' },
  { question: 'How do I request a quote?', answer: 'Contact us by email or WhatsApp with your product concept and purchasing requirements.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
---
<BaseLayout title={topic.data.title} description={topic.data.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <Header />
  <FloatingContact />
  <main class="pt-28"><section class="bg-mist py-16 sm:py-24"><div class="container-site max-w-4xl"><a href={base} class="text-sm font-bold text-ink/60 hover:text-coral">← Back to home</a><p class="eyebrow mt-10">{topic.data.eyebrow}</p><h1 class="font-display text-4xl font-bold leading-tight tracking-tight sm:text-6xl">{topic.data.title}</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-ink/70">{topic.data.description}</p><div class="mt-8 flex flex-wrap gap-2">{topic.data.keywords.map((keyword) => <span class="rounded-full bg-white px-4 py-2 text-xs font-bold text-moss">{keyword}</span>)}</div></div></section>
  <section class="py-16 sm:py-24"><div class="container-site grid gap-12 lg:grid-cols-[minmax(0,1fr)_300px]"><article class="topic-copy max-w-3xl"><Content /></article><aside class="h-fit rounded-3xl bg-ink p-7 text-white"><p class="text-xs font-bold uppercase tracking-[.14em] text-coral">Start a project</p><h2 class="mt-3 font-display text-2xl font-bold">Ready to discuss your product?</h2><p class="mt-3 text-sm leading-6 text-white/65">Tell us about your concept, quantity and target market.</p><a href="https://wa.me/8617625983675" class="button-primary mt-6 w-full !bg-coral">Chat on WhatsApp</a><a href="mailto:kyle.zhanghang@gmail.com" class="mt-3 block text-center text-sm font-bold hover:text-coral">Email us</a></aside></div></section>
  <section class="bg-white py-16 sm:py-24"><div class="container-site"><p class="eyebrow">Related capabilities</p><h2 class="font-display text-3xl font-bold sm:text-4xl">Explore the topic cluster.</h2><div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">{topics.map((item) => <a href={`${basePath}${item.id}`} class="rounded-2xl border border-ink/10 p-5 transition hover:-translate-y-1 hover:border-coral"><p class="text-xs font-bold uppercase tracking-[.1em] text-coral">{item.data.eyebrow}</p><h3 class="mt-3 font-display text-lg font-bold">{item.data.title}</h3><span class="mt-5 block text-sm font-bold text-moss">Read more →</span></a>)}</div></div></section>
  <section class="bg-oat py-16 sm:py-24"><div class="container-site max-w-4xl"><p class="eyebrow">Common questions</p><h2 class="font-display text-3xl font-bold sm:text-4xl">Planning an AI plush toy project.</h2><div class="mt-8">{faq.map((item) => <details class="border-t border-ink/15 py-5"><summary class="cursor-pointer list-none font-display text-lg font-bold">{item.question}<span class="float-right text-coral">+</span></summary><p class="mt-3 max-w-2xl text-sm leading-6 text-ink/65">{item.answer}</p></details>)}</div></div></section></main>
  <Footer />
</BaseLayout>
