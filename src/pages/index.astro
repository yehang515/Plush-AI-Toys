---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import FactoryCarousel from '../components/FactoryCarousel.astro';
import { getCollection } from 'astro:content';
import capabilities from '../data/capabilities.json';
import faqSource from '../data/faq.yaml?raw';
import { parse } from 'yaml';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const faqs = parse(faqSource) as { question: string; answer: string }[];
const description = 'Pluzy is an AI toy factory in China for custom AI toys, AI plush toys, talking toys and OEM / ODM smart toy manufacturing.';
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
const organizationSchema = { '@context': 'https://schema.org', '@type': ['Organization', 'Manufacturer'], name: 'Pluzy', alternateName: 'Pluzy AI Toy Factory', url: Astro.site, logo: new URL('/images/logo.jpg', Astro.site).href, description, email: 'kyle.zhanghang@gmail.com', knowsAbout: ['AI toys', 'AI toy manufacturing', 'AI plush toys', 'smart toys', 'talking toys', 'OEM manufacturing', 'ODM manufacturing'], contactPoint: { '@type': 'ContactPoint', contactType: 'sales', telephone: '+8617625983675', availableLanguage: ['English'] } };
const factoryVideo = 'https://youtu.be/KI4cpZEUQ5k';
const factoryVideoEmbed = 'https://www.youtube.com/embed/KI4cpZEUQ5k';
const base = import.meta.env.BASE_URL;
const basePath = base === '/' ? '/' : `${base}/`;
const withBase = (path: string) => base === '/' ? path : `${base}${path}`;
---
<BaseLayout title="AI Toy Factory & Manufacturer in China | OEM, ODM & Custom AI Toys" description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  <Header />
  <FloatingContact />
  <main>
    <FactoryCarousel />
    <section class="bg-mist py-20 sm:py-28" aria-labelledby="factory-video-heading"><div class="container-site grid items-center gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow">See Pluzy in action</p><h2 id="factory-video-heading" class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Inside our AI toy factory.</h2><p class="mt-5 max-w-md leading-7 text-ink/70">See the people, processes and product details behind Pluzy’s AI toy and smart plush manufacturing in China.</p><a href={factoryVideo} class="button-primary mt-7" target="_blank" rel="noopener noreferrer">Watch on YouTube →</a></div><div class="overflow-hidden rounded-3xl bg-ink shadow-2xl"><iframe class="aspect-video w-full" src={factoryVideoEmbed} title="Inside the Pluzy AI Toy Factory" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></div></section>
    <section id="products" class="bg-white py-20 sm:py-28"><div class="container-site"><div><p class="eyebrow">Our products</p><h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Explore the complete collection.</h2></div><div class="mt-12 grid gap-6 md:grid-cols-2">{products.filter((product) => product.data.image).map((product) => <article class="group overflow-hidden rounded-3xl border border-ink/10 bg-white"><a href={`${basePath}products/${product.id}`} aria-label={`View ${product.data.title} details`}><img src={withBase(product.data.image!)} alt={product.data.title} class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]" /></a><div class="p-7"><p class="text-xs font-bold uppercase tracking-[.14em] text-coral">{product.data.category}</p><h3 class="mt-2 font-display text-2xl font-bold">{product.data.title}</h3><p class="mt-3 text-sm leading-6 text-ink/65">{product.data.excerpt}</p><div class="mt-5 flex gap-4"><a class="text-sm font-bold text-moss hover:text-coral" href={`${basePath}products/${product.id}`}>View product →</a>{product.data.video && <a class="text-sm font-bold text-ink/55 hover:text-coral" href={product.data.video}>Watch video</a>}</div></div></article>)}</div></div></section>
    <section id="about" class="bg-white py-20 sm:py-28" aria-labelledby="about-heading"><div class="container-site grid gap-12 lg:grid-cols-[.85fr_1.15fr]"><div><p class="eyebrow">About Pluzy Toys</p><h2 id="about-heading" class="font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl">Turning design into AI plush toys is our lifelong mission.</h2><p class="mt-6 max-w-xl text-lg leading-8 text-ink/70">Pluzy Toys is a custom AI plush toy manufacturer with two factories. For more than 20 years, we have focused on high-quality plush toys, supporting both custom and wholesale AI plush toy projects.</p></div><div class="grid gap-5 sm:grid-cols-3"><div class="rounded-3xl bg-mist p-6"><p class="font-display text-4xl font-bold text-coral">10,000 ㎡</p><p class="mt-3 text-sm font-bold text-ink">Factory area</p><p class="mt-2 text-sm leading-6 text-ink/65">Two production facilities built for quality-focused plush manufacturing.</p></div><div class="rounded-3xl bg-mist p-6"><p class="font-display text-4xl font-bold text-coral">500+</p><p class="mt-3 text-sm font-bold text-ink">Skilled workers</p><p class="mt-2 text-sm leading-6 text-ink/65">Supported by 23 professional designers and 12 dedicated QCs.</p></div><div class="rounded-3xl bg-mist p-6"><p class="font-display text-4xl font-bold text-coral">20+ years</p><p class="mt-3 text-sm font-bold text-ink">Manufacturing experience</p><p class="mt-2 text-sm leading-6 text-ink/65">From custom concepts to wholesale-ready product collections.</p></div></div></div><div class="container-site mt-12 grid gap-8 border-t border-ink/10 pt-10 lg:grid-cols-2"><div><h3 class="font-display text-2xl font-bold">Quality and compliance come first.</h3><p class="mt-4 max-w-2xl leading-7 text-ink/70">Each plush toy undergoes strict quality inspection. Our factory holds EN71, ICTI, BSCI, GRS, FSC, ISO and Sedex certifications.</p></div><div><h3 class="font-display text-2xl font-bold">A trusted custom plush partner.</h3><p class="mt-4 max-w-2xl leading-7 text-ink/70">We have worked with brands including Walmart, Dollar Tree and Singleton, providing one-stop custom plush toy services. We never sacrifice quality for cost.</p></div></div></section>

    <section id="solutions" class="py-20 sm:py-28"><div class="container-site"><div class="max-w-2xl"><p class="eyebrow">Built around your brief</p><h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">A full path from plush concept to product.</h2></div><div class="mt-12 grid gap-px overflow-hidden rounded-3xl bg-ink/10 sm:grid-cols-2 lg:grid-cols-4">{capabilities.map((item) => <article class="bg-oat p-7"><p class="font-display text-3xl font-bold text-coral">{item.number}</p><h3 class="mt-12 font-display text-xl font-bold">{item.title}</h3><p class="mt-3 text-sm leading-6 text-ink/65">{item.text}</p></article>)}</div></div></section>

    <section id="oem-odm" class="bg-ink py-20 text-white sm:py-28"><div class="container-site grid gap-12 lg:grid-cols-[.9fr_1.1fr]"><div><p class="eyebrow">OEM & ODM manufacturing</p><h2 class="font-display text-4xl font-bold leading-tight sm:text-5xl">Your brand, your character, your product story.</h2></div><div class="grid gap-7 sm:grid-cols-2"><div class="border-t border-white/25 pt-5"><h3 class="font-display text-xl font-bold">OEM manufacturing</h3><p class="mt-3 text-sm leading-6 text-white/65">Have a defined product? Bring the design, specifications and branding direction to the manufacturing conversation.</p></div><div class="border-t border-white/25 pt-5"><h3 class="font-display text-xl font-bold">ODM development</h3><p class="mt-3 text-sm leading-6 text-white/65">Start with an idea. Shape the character, plush form, user interaction and presentation with a guided development process.</p></div><div class="border-t border-white/25 pt-5 sm:col-span-2"><h3 class="font-display text-xl font-bold">Private & white label</h3><p class="mt-3 text-sm leading-6 text-white/65">Create a cohesive retail-ready range with your own labels, packaging and brand touchpoints.</p></div></div></div></section>

    <section id="process" class="py-20 sm:py-28"><div class="container-site grid gap-12 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow">A clear development process</p><h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Less guesswork. More momentum.</h2><p class="mt-5 max-w-sm leading-7 text-ink/65">A thoughtful product needs a clear handoff at every milestone. We keep the conversation focused on the details that move your project forward.</p></div><ol class="grid gap-0">{['Share your concept and target market', 'Align on product scope and custom features', 'Develop sample direction and refine details', 'Prepare for production and launch'].map((step, index) => <li class="flex gap-5 border-t border-ink/15 py-6"><span class="font-display text-2xl font-bold text-coral">0{index + 1}</span><span class="pt-1 font-display text-xl font-bold">{step}</span></li>)}</ol></div></section>


    <section id="faq" class="py-20 sm:py-28"><div class="container-site grid gap-12 lg:grid-cols-[.75fr_1.25fr]"><div><p class="eyebrow">FAQ</p><h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Questions, answered.</h2></div><div>{faqs.map((faq) => <details class="border-t border-ink/15 py-5"><summary class="cursor-pointer list-none font-display text-lg font-bold marker:hidden">{faq.question}<span class="float-right text-coral">+</span></summary><p class="mt-3 max-w-2xl text-sm leading-6 text-ink/65">{faq.answer}</p></details>)}</div></div></section>

    <section id="contact" class="bg-coral py-20 sm:py-28"><div class="container-site grid gap-10 lg:grid-cols-2"><div><p class="eyebrow !text-ink">Start your project</p><h2 class="font-display text-4xl font-bold leading-tight text-ink sm:text-5xl">Let’s make your next plush idea feel alive.</h2><p class="mt-5 max-w-md leading-7 text-ink/75">Tell us about your character, market and the interactive experience you have in mind.</p><div class="mt-8 space-y-2 text-sm font-bold"><a class="block" href="mailto:kyle.zhanghang@gmail.com">kyle.zhanghang@gmail.com</a><a class="block" href="https://wa.me/8617625983675">WhatsApp: +86 176 2598 3675</a></div></div><form class="rounded-3xl bg-oat p-6 sm:p-8" action="mailto:kyle.zhanghang@gmail.com" method="post" enctype="text/plain"><div class="grid gap-5 sm:grid-cols-2"><label class="text-sm font-bold">Name<input required name="name" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 font-normal outline-none focus:border-ink" /></label><label class="text-sm font-bold">Work email<input required type="email" name="email" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 font-normal outline-none focus:border-ink" /></label><label class="text-sm font-bold sm:col-span-2">Tell us about your project<textarea required name="message" rows="4" placeholder="Character, features, target market, estimated quantity…" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 font-normal outline-none focus:border-ink"></textarea></label></div><button class="button-primary mt-6" type="submit">Send inquiry →</button><p class="mt-3 text-xs leading-5 text-ink/55">Submitting opens your email application. You can also contact us directly by email or WhatsApp.</p></form></div></section>
  </main>
  <Footer />
</BaseLayout>
