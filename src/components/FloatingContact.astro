---
const base = import.meta.env.BASE_URL;
const catalogue = base === '/' ? '/images/Product_Catalog_EN.pdf' : `${base}/images/Product_Catalog_EN.pdf`;
---
<aside class="fixed right-4 top-1/2 z-30 flex -translate-y-1/2 flex-col gap-2 sm:right-6" aria-label="Quick contact">
  <a href="https://wa.me/8617625983675" class="flex items-center gap-3 rounded-2xl bg-[#25D366] px-4 py-3 text-sm font-bold text-white shadow-xl transition hover:-translate-y-0.5" aria-label="Chat on WhatsApp"><span class="grid h-7 w-7 place-items-center rounded-full bg-white/20 text-base">◔</span><span>WhatsApp</span></a>
  <a href="mailto:kyle.zhanghang@gmail.com" class="flex items-center gap-3 rounded-2xl bg-ink px-4 py-3 text-sm font-bold text-white shadow-xl transition hover:-translate-y-0.5" aria-label="Email"><span class="grid h-7 w-7 place-items-center rounded-full bg-white/15 text-base">@</span><span>Email</span></a>
  <a href={catalogue} download class="flex items-center gap-3 rounded-2xl bg-coral px-4 py-3 text-sm font-bold text-ink shadow-xl transition hover:-translate-y-0.5 hover:bg-white" aria-label="Download Pluzy product catalogue"><span class="grid h-7 w-7 place-items-center rounded-full bg-white/35 text-base">↓</span><span>Product Catalogue</span></a>
</aside>
